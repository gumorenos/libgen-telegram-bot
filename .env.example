# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Comma-separated Telegram numeric user IDs. Leave empty only for initial /whoami discovery.
ALLOWED_USER_IDS=

# Runtime settings
DATA_DIR=/data
MAX_RESULTS=8
MAX_DOWNLOAD_MB=48
MAX_UPLOAD_MB=19
LOG_LEVEL=INFO

# Catalog providers. Supported: gutenberg, libgen
# LibGen is metadata-only and disabled by default.
ENABLED_PROVIDERS=gutenberg
GUTENDEX_BASE_URL=https://gutendex.com

# Local, read-only LibGen-compatible SQLite FTS metadata index.
# This becomes relevant only when `libgen` is included in ENABLED_PROVIDERS.
LIBGEN_METADATA_DB=/data/libgen-metadata.sqlite3
