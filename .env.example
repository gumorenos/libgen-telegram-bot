# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Comma-separated Telegram numeric user IDs. Leave empty only for initial /whoami discovery.
ALLOWED_USER_IDS=

# Runtime settings
DATA_DIR=/data
MAX_RESULTS=8
MAX_DOWNLOAD_MB=48
MAX_UPLOAD_MB=19
LOG_LEVEL=INFO

# Legal public-domain catalog
GUTENDEX_BASE_URL=https://gutendex.com
