# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Comma-separated Telegram numeric user IDs. Leave empty only for initial /whoami discovery.
ALLOWED_USER_IDS=

# Runtime settings
DATA_DIR=/data
MAX_RESULTS=8
MAX_DOWNLOAD_MB=48
MAX_UPLOAD_MB=19
LOG_LEVEL=INFO

# Catalog providers. Supported: gutenberg, libgen
ENABLED_PROVIDERS=gutenberg
GUTENDEX_BASE_URL=https://gutendex.com

# Optional LibGen integration. `libgen` is a hybrid metadata provider:
# 1) it searches the local read-only SQLite index when present;
# 2) if needed, it falls back to the configured live HTTPS mirrors.
# No LibGen download URLs are exposed by the bot.
LIBGEN_METADATA_DB=/data/libgen-metadata.sqlite3

# Comma-separated HTTPS mirror base URLs, supplied by the operator.
# Example shape only: https://mirror-one.example,https://mirror-two.example
LIBGEN_LIVE_MIRRORS=
